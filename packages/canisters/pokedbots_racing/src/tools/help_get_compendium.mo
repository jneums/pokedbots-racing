import Result "mo:base/Result";

import McpTypes "mo:mcp-motoko-sdk/mcp/Types";
import AuthTypes "mo:mcp-motoko-sdk/auth/Types";
import Json "mo:json";
import ToolContext "ToolContext";

module {
  public func config() : McpTypes.Tool = {
    name = "help_get_compendium";
    title = ?"PokedBots Racing Compendium";
    description = ?"Get comprehensive reference for game mechanics: factions, stats, zones, resonance, overcharge, upgrade curves, battery degradation, and race class brackets. Call once per conversation for context.";
    payment = null;
    inputSchema = Json.obj([
      ("type", Json.str("object")),
      ("properties", Json.obj([("section", Json.obj([("type", Json.str("string")), ("enum", Json.arr([Json.str("all"), Json.str("core"), Json.str("factions"), Json.str("battery"), Json.str("terrain"), Json.str("upgrades"), Json.str("scavenging"), Json.str("resonance"), Json.str("starter_bots"), Json.str("gear"), Json.str("consumables"), Json.str("betting"), Json.str("dedication"), Json.str("leaderboard"), Json.str("luck"), Json.str("phenomenon"), Json.str("elo"), Json.str("events"), Json.str("cancellation"), Json.str("smr"), Json.str("marketplace")])), ("description", Json.str("Which section to retrieve (default: all)"))]))])),
      ("required", Json.arr([])),
    ]);
    outputSchema = null;
  };

  public func handle(ctx : ToolContext.ToolContext) : (
    _args : McpTypes.JsonValue,
    _auth : ?AuthTypes.AuthInfo,
    cb : (Result.Result<McpTypes.CallToolResult, McpTypes.HandlerError>) -> (),
  ) -> async () {
    func(_args : McpTypes.JsonValue, _auth : ?AuthTypes.AuthInfo, cb : (Result.Result<McpTypes.CallToolResult, McpTypes.HandlerError>) -> ()) : async () {

      let section = switch (Result.toOption(Json.getAsText(_args, "section"))) {
        case (null) { "all" };
        case (?s) { s };
      };

      let coreConceptsInfo = "**CORE CONCEPTS:**\n\n**CORE RACING STATS (The 4 Stats That Matter):**\n• Speed - Top speed capability\n• Power Core - Energy efficiency (reduces battery drain)\n• Acceleration - Launch power\n• Stability - Handling and durability\n\n**Bot Rating = Average of all 4 stats**\n• Rating increases by +1 for every +4 total stat points\n• Example: 20/20/20/20 = Rating 20\n• Specialization: Can push one stat high (e.g., 60/20/20/20 = Rating 30)\n• Balanced: Spread evenly (e.g., 30/30/30/30 = Rating 30)\n\n**RACE CLASS SYSTEM (CRITICAL - READ CAREFULLY):**\n• **Rating determines which races you can enter** (class/bracket system):\n  - Rating 50+ → 👑 SilentKlan races\n  - Rating 40-49 → 🥇 Elite races\n  - Rating 30-39 → 🥈 Raider races\n  - Rating 20-29 → 🥉 Junker races\n  - Rating 0-19 → 🗑️ Scrap races\n• **ELO is separate** - only used for matchmaking WITHIN your rating-based class\n• **To enter Elite races:** You need Rating 40-49 (NOT ELO 40-49)\n• **Example:** A bot with Rating 45 and ELO 1200 can enter Elite races (rating determines eligibility)\n\n**Resources (NOT stats, consumed/restored):**\n• Battery - Fuel for racing, restored via recharge (0.1 ICP, 2hr cooldown)\n• Condition - Wear/tear, restored via repair (0.05 ICP, 1hr cooldown)\n• Low battery/condition hurt performance but don't affect rating\n• Battery/condition only impact race performance temporarily";

      let factionInfo = "**FACTION BONUSES:**\n\n**Ultra-Rare Factions:**\n• UltimateMaster: +15% all stats, -25% to -40% decay rates\n• Wild: +20% Accel, -10% Stability\n• Golden: +15% all stats when condition ≥90% (pristine maintenance required)\n• Ultimate: +12% Speed/Accel\n\n**Super-Rare Factions:**\n• Blackhole: +12% on MetalRoads terrain, world buffs grant +3 Speed/Accel BONUS on top of regular buff\n• Dead: +10% PowerCore, +8% Stability, -15% decay\n• Master: +12% Speed, +8% PowerCore, every 10th scavenge mission doubles parts\n\n**Rare Factions:**\n• Bee: +10% Acceleration\n• Food: +8% condition recovery\n• Box: +10% on ScrapHeaps terrain, 5% chance to triple scavenging parts\n• Murder: +8% Speed/Accel\n\n**Common Factions:**\n• Game: +8% on WastelandSand terrain, +10 parts every 5th scavenge\n• Animal: +3% balanced all stats\n• Industrial: +5% PowerCore/Stability";

      let batteryInfo = "**BATTERY MECHANICS (aka 'Energy'):**\n\n**Power Core = Energy Efficiency:**\nHigher Power Core reduces battery drain logarithmically:\n• powerCore=20: 70% drain\n• powerCore=40: 52% drain\n• powerCore=100: 30% drain (3.3x more races per battery)\n\n**BATTERY PENALTIES (affects Speed/Acceleration):**\n• 80-100%: No penalty (1.0x)\n• 50-80%: -0% to -25% (0.75x-1.0x linear)\n• 25-50%: -25% to -50% (0.50x-0.75x) ← 29% = ~46% reduction!\n• 10-25%: -50% to -75% (0.25x-0.50x)\n• 0-10%: -75% to -90% (0.10x-0.25x) resurrection sickness\n\n**Recharge:** 0.1 ICP, restores 50-90 battery (RNG), 2hr cooldown\n\n**OVERCHARGE MECHANIC (Modified by Resonance!):**\n• Base formula: (100 - battery) × 0.4 × efficiency × resonance_modifier\n• Efficiency = 0.5 + condition/200 + random(-0.25, +0.25)\n• Resonance modifier:\n  - Peak resonance: 100% potential\n  - Good resonance: 80% potential\n  - Outside resonance: 60% potential (baseline)\n• Max overcharge: 40%\n• Consumed in next race:\n  - Speed/Accel: +0.20% per 1% overcharge (max +8% at 40%)\n  - Stability/PowerCore: -0.133% per 1% overcharge (unless Perfect Tune-Up)\n• Strategy: Check resonance before recharging for maximum overcharge!";

      let resonanceInfo = "**RESONANCE SYSTEM (Per-Bot Maintenance Optimization):**\n\n**What is Resonance?**\nEach bot has a unique 'resonance field' generated by Perlin noise. This creates slowly-drifting optimal maintenance points that differ for each bot. Gone are the days of 'select all → repair → wait for 0% → recharge' batch optimization!\n\n**How It Works:**\n• Each bot's token index seeds a unique Perlin noise field\n• Optimal points drift slowly over time (~6 hour update cycle)\n• Recharge and repair have independent optimal points\n• Use garage_get_robot_details to see your bot's current resonance\n\n**Resonance Zones:**\n• 🔮 Peak Zone (±3% of optimal): Maximum bonus!\n  - Recharge: 100% overcharge potential\n  - Repair: Full Perfect Tune-Up (ALL penalties removed)\n• ✨ Good Zone (±10% of optimal): Partial bonus\n  - Recharge: 80% overcharge potential\n  - Repair: Partial Tune-Up (70% of penalties removed)\n• Standard (outside zones): Baseline behavior\n  - Recharge: 60% overcharge potential\n  - Repair: Overcharge RESET (no tune-up, exploit protection)\n\n**OVERCHARGE with Resonance:**\n• Recharging in peak/good resonance = higher overcharge\n• Recharging outside resonance = reduced but still usable overcharge\n• Example: Bot at 20% battery\n  - In peak resonance: Could get up to 32% overcharge\n  - In good resonance: Could get up to 25% overcharge\n  - Outside resonance: Could get up to 19% overcharge\n\n**PERFECT TUNE-UP with Resonance:**\n• Repairing WITH overcharge in resonance zone = Perfect Tune-Up\n• Peak resonance: 100% of overcharge penalties removed!\n• Good resonance: 70% of overcharge penalties removed\n• Outside resonance: Overcharge is RESET (prevents exploit loops)\n• You keep the Speed/Accel boost, lose the Stability/PowerCore penalty!\n\n**Time Drift:**\n• Primary cycle: ~7 days (slow drift of optimal points)\n• Secondary cycle: ~6 hours (micro-variations)\n• Optimal points range: 20%-80% (never at extremes)\n• Field stability shown: 'Stable', 'Shifting', or 'Volatile'\n\n**Strategic Tips:**\n1. Check resonance BEFORE maintenance actions\n2. Different bots have different optimal points - no more batch optimization!\n3. If not in resonance now, check back in a few hours\n4. Plan ahead: if repair resonance is good, build overcharge first then repair\n5. Active managers who track resonance are rewarded with better bonuses";

      let terrainInfo = "**TERRAIN BONUSES:**\n\n**Preferred Terrain:** +5% all stats when racing on bot's preferred terrain (derived from NFT background color)\n\n**Faction Terrain Bonuses (stack with preferred):**\n• Blackhole: +12% on MetalRoads\n• Golden: +15% all stats when condition ≥90%\n• Box: +10% on ScrapHeaps\n• Game: +8% on WastelandSand\n\n**Race Terrain Effects (weighted by track segment composition):**\n• ScrapHeaps: 1.2x battery drain, 1.5x condition wear (rough)\n• WastelandSand: 1.1x battery drain, 1.2x condition wear (sandy)\n• MetalRoads: 1.0x battery drain, 1.0x condition wear (smooth)";

      let upgradeInfo = "**UPGRADE SYSTEM V2 (Gacha-Style RNG):**\n\n**Payment Methods (Choose Either):**\n• **ICP Payment:** Direct payment via ICRC-2 approval, instant processing\n• **Parts Payment:** Use parts from inventory (earned via racing/scavenging)\n  - Speed Chips → Velocity upgrades\n  - Power Core Fragments → PowerCore upgrades\n  - Thruster Kits → Thruster upgrades\n  - Gyro Modules → Gyro upgrades\n  - Universal Parts → Can substitute for ANY type\n• **Conversion Rate:** 100 parts = 1 ICP equivalent\n\n**Upgrade Cost Scaling:**\n• Formula: baseCost = 0.5 + (currentStat/40)² × [0.5 + (rating/40)^1.5]\n• Costs increase with BOTH current stat value AND bot rating\n• Higher individual stat = exponentially more expensive\n• Same rating gain costs MUCH less when spreading across stats\n• Example for +1 rating (+4 total stat points):\n  - Balanced (20→21 on 4 stats): ~2.8 ICP total\n  - Specialized (50→54 on 1 stat): ~12+ ICP total\n• Premium scales smoothly with rating (no harsh breakpoints):\n  - Rating 20: 0.86× premium (~0.43 ICP base)\n  - Rating 40: 1.5× premium (~0.75 ICP base)\n  - Rating 60: 2.37× premium (~1.19 ICP base)\n  - Rating 80: 3.36× premium (~1.68 ICP base)\n  - Rating 100: 4.48× premium (~2.24 ICP base)\n\n**Success Rates (RNG-Based, PER STAT):**\n• Each stat tracked independently (Speed, Power Core, Acceleration, Stability)\n• Smooth curve: 85% (first upgrade) → 1% (at 15 upgrades), then stays at 1%\n• Formula: 85% - (upgradeCount × 5.6%), minimum 1%\n• Examples:\n  - 0 upgrades: 85.0%\n  - 5 upgrades: 57.0%\n  - 10 upgrades: 29.0%\n  - 15 upgrades: 1.0%\n  - 16+ upgrades: 1.0% (soft cap)\n\n**Pity System:**\n• +5% success per consecutive failure (max +25%)\n• Resets on any success\n• Can boost late-game 1% → 26% after 5 fails\n\n**Double Point Lottery:**\n• 15% → 2% chance (upgrades 0-15), then 0%\n• Awards +2 stat points instead of +1\n• Disabled completely after +15 upgrades per stat\n• Creates exciting 'jackpot' moments\n\n**50% Refund on Failure (Both Payment Methods):**\n• ICP: 50% refunded automatically via prize distribution\n• Parts: 50% returned directly to inventory\n• Reduces financial risk for both payment types\n• Refund matches payment method used\n\n**Instant Results:** Upgrades complete immediately with RNG roll shown instantly!";

      let scavengingInfo = "**SCAVENGING SYSTEM:**\n\n**Mission Types:**\n• ShortExpedition (5h): 15-35 parts, 10 battery\n• DeepSalvage (11h): 40-80 parts, 20 battery\n• WastelandExpedition (23h): 100-200 parts, 40 battery\n\n**Zones & Part Distribution:**\n• ScrapHeaps: Safe (1.0x multipliers, 40% universal parts)\n• AbandonedSettlements: Moderate (1.4x parts, 1.1x battery, 1.15x condition, 25% universal)\n• DeadMachineFields: Dangerous (2.0x parts, 1.2x battery, 1.3x condition, 10% universal)\n• RepairBay: Restores condition instead of gathering parts (1.0x battery drain)\n• ChargingStation: Restores battery for free (+1 per tick), no battery drain. Shared garage power grid limits concurrent charging\n\n**Part Types:** Speed Chips, Power Core Fragments, Thruster Kits, Gyro Modules, Universal Parts\n\n**STAT-BASED BONUSES:**\n• Power Core (Energy Efficiency):\n  - 80+: -20% battery cost\n  - 50-79: -10% battery cost\n  - <50: Normal cost\n• Condition (Consistency):\n  - 80+: Tight variance (90-110%, ±10%)\n  - 50-79: Normal variance (80-120%, ±20%)\n  - <50: Wide variance (70-130%, ±30% risky/swingy)\n• Stability (Durability in Dangerous Zones):\n  - 70+ in DeadMachineFields: -25% condition loss\n  - Otherwise: Normal condition loss\n\n**World Buff Chance (RARE - ~4% per hour):**\n• 1% per 15-min accumulation check (up to 1.6% with max Acceleration)\n• NOT awarded on completion (prevents spam abuse)\n• Buffs: <3h: +2 speed | 3-8h: +3 speed, +2 accel | 8h+: +4 speed, +3 accel, +2 power\n• Expires in 48h if unused\n• Almost impossible to get in under 1 hour\n\n**Faction Bonuses (Parts Multipliers):**\n• UltimateMaster: 1.20x all zones, -30% battery, 15% double parts, +20 battery return, +15% Universal Parts (scavenging)\n• Golden: 15% chance to double parts, +30% Power Core Fragments (scavenging)\n• Ultimate: 1.15x all zones, -15% mission time, +15% Universal Parts (scavenging)\n• Wild: 1.25x WastelandSand, 2x world buff potency (50% proc chance), -40% condition loss, +30% Speed Chips (scavenging)\n• Blackhole: 1.10x all zones, world buffs grant +3 Speed/Accel bonus ON TOP of regular buff, +50% condition damage, +30% Power Core Fragments (scavenging)\n• Dead: 1.40x DeadMachineFields (1.10x others), -50% condition loss, +15% Universal Parts (scavenging)\n• Master: 1.12x all zones, -25% battery, every 10th mission doubles parts, +15% Universal Parts (scavenging)\n• Bee: 1.08x AbandonedSettlements, +10% on 23h, shared buffs if 2+ Bee bots, +30% Speed Chips (scavenging)\n• Food: 1.12x ScrapHeaps/Settlements, -20% battery, +30% world buff strength, +15% Universal Parts (scavenging)\n• Box: 1.05x all zones, 5% chance to triple parts, +30% Gyro Modules (scavenging)\n• Murder: 1.15x DeadMachineFields, +20% condition damage, +15% Universal Parts (scavenging)\n• Game: 1.0x base, +10 parts every 5th mission, +30% Thruster Kits (scavenging)\n• Animal: 1.08x WastelandSand, -15% condition loss on 11h/23h, buffs last 2 races, +30% Thruster Kits (scavenging)\n• Industrial: 1.05x all zones, -10% battery, reduced variance (90-110% instead of 80-120%), +30% Gyro Modules (scavenging)\n\n**Scavenging Part Specializations:**\n• Speed Specialists (Bee, Wild): +30% more Speed Chips\n• Power Specialists (Blackhole, Golden): +30% more Power Core Fragments\n• Acceleration Specialists (Game, Animal): +30% more Thruster Kits\n• Stability Specialists (Industrial, Box): +30% more Gyro Modules\n• Balanced Factions (Dead, Master, Murder, Food, UltimateMaster, Ultimate): +15% more Universal Parts";

      let starterBotInfo = "**STARTER BOTS:**\n\n**What Are Starter Bots?**\n• Free bots for new players who don't own a PokedBots NFT\n• Synthetic token indices in the 100000+ range (not real NFTs)\n• Each principal gets up to 4 slots (one per class)\n\n**Starter Bot Classes & Stats:**\n• Scrap (indices 100000-109999): All stats = 19 (Rating 19)\n• Junker (indices 110000-119999): All stats = 29 (Rating 29)\n• Raider (indices 120000-129999): All stats = 39 (Rating 39)\n• Elite (indices 130000-139999): All stats = 49 (Rating 49)\n\n**Allowed Factions:** Game, Animal, Industrial, Food (common factions only)\n\n**Limitations:**\n• Cannot be traded or sold\n• One per class per principal\n• Use garage_claim_starter_bot to claim, garage_delete_starter_bot to remove";

      let gearInfo = "**GEAR SYSTEM (WoW-Style Loot):**\n\n**6 Gear Slots:**\n• Legs (primary: Speed), Thruster (primary: Acceleration)\n• Chassis (primary: Stability), Gyro (primary: Stability/Accel)\n• Core (primary: PowerCore), Module (wildcard: any stat)\n\n**5 Rarities & Base Stat Budgets (at ilvl 1, +1 per ilvl):**\n• Common: 3 pts | Uncommon: 5 pts | Rare: 8 pts | Epic: 12 pts | Legendary: 16 pts\n\n**3 Categories:**\n• Standard (70% drop rate): Pure stat budget, no passive\n• Unique (25%): ~60-70% stat budget + passive effect\n• Named (5%): ~90-100% budget + powerful passive (special events)\n\n**Passive Effects:**\n• SlipstreamBoost, ComebackKid, FastStarter, TerrainMastery\n• SteadyPace, LuckAmplifier, Ironclad, FinalSurge\n• RubberBandResist, UphillGrinder, DownhillDaredevil, PackRunner\n\n**Gear Properties:**\n• Soulbound to the bot that earned it (cannot be traded)\n• Has a TerrainTag (ScrapHeaps/WastelandSand/MetalRoads/Universal)\n• Item Level (ilvl) increases each season — old gear naturally outpaced\n• Crafting: Combine 3 gear of same rarity → 1 of next rarity\n\n**Drop Rates by Event Tier:**\n• Free Sprint: Always Common, always Standard\n• Daily Sprint: Ceiling Rare (85% Common, 13% Uncommon, 2% Rare)\n• Weekly League: Ceiling Epic (45% Common, 30% Uncommon, 18% Rare, 7% Epic)\n• Monthly Cup: Guaranteed Rare+ (45% Rare, 35% Epic, 8% Legendary)\n• Special Event: Legendary eligible (60% C, 25% U, 10% R, 4% E, 1% L)";

      let consumableInfo = "**CONSUMABLE SYSTEM:**\n\n**What Are Consumables?**\n• One-shot items equipped before a race, consumed when trigger fires\n• Each bot can equip up to 2 consumables per race\n• Dropped from races alongside gear\n\n**Trigger Types (when the consumable activates):**\n• OnRaceStart: Fires at segment 0\n• OnLastPlace: Fires when bot enters last place\n• OnOvertaken: Fires when bot is passed by another\n• OnFinalLap: Fires at start of last lap\n• OnLuckProc: Fires when a luck proc triggers\n• OnBadLuck: Fires when a bad luck event happens\n• OnLeadChange: Fires when bot takes the lead\n\n**Effect Types:**\n• NitroBoost: Raw speed boost % for N segments\n• ShieldPlating: Blocks bad luck events for N segments\n• OverclockPulse: Flat bonus to all stats for N segments\n• TerrainAdapt: Nullify terrain penalties for N segments\n• LuckSurge: Force a guaranteed luck proc (Minor or Major)";

      let bettingInfo = "**BETTING SYSTEM (Pari-Mutuel):**\n\n**How It Works:**\n• Pari-mutuel pools — odds determined by total bets, not house\n• Betting opens when registration closes, closes when race starts\n• All bets go into pool subaccounts (non-custodial on ICP ledger)\n\n**Bet Types:**\n• Win: Bot finishes 1st\n• Place: Bot finishes top 3\n• Show: Bot finishes top 5\n\n**Limits:**\n• Min bet: 0.1 ICP | Max bet: 100 ICP\n• Max 100 ICP total per user per race\n\n**Rake: 10% total**\n• 8% goes to racing prize pools\n• 2% goes to platform treasury\n\n**Settlement:** Automatic after race completion. Payouts distributed proportionally from pool minus rake. Cancelled races = full refund.";

      let dedicationInfo = "**BOT DEDICATION SYSTEM:**\n\n**Earning Dedication Points (DP):**\n• ICP Spending: 100 DP per 1 ICP spent (recharges, repairs, upgrades, race entries)\n• Racing: 5 DP per race, +15 bonus for wins, +8 for podiums\n• Scavenging: 3 DP per run, +1 per 10 parts, +1 per 25 battery, +1 per 10 condition\n\n**6 Tiers (DP Thresholds):**\n• Tier 0 - Rookie (0 DP): No bonuses\n• Tier 1 - Dedicated (700 DP): +1 Speed, +1% terrain, +10% scav yield, -10% recharge CD\n• Tier 2 - Veteran (2,700 DP): +1 Spd/+1 Accel, +2% terrain, +15% scav, -20% recharge, -10% repair CD\n• Tier 3 - Champion (8,000 DP): +2 Spd/+1 Accel/+1 Power, +3% terrain, +20% scav, -30% recharge, -20% repair, -5% upgrade cost\n• Tier 4 - Elite (20,000 DP): +2 Spd/+2 Accel/+1 Power/+1 Stab, +4% terrain, +25% scav, -40% recharge, -30% repair, -10% upgrade cost\n• Tier 5 - Legend (60,000 DP): +3 ALL stats, +5% terrain, +30% scav, -50% recharge, -40% repair, -15% upgrade cost\n\n**Note:** Stat bonuses affect racing performance but NOT rating calculation";

      let leaderboardInfo = "**LEADERBOARD SYSTEM:**\n\n**Board Types:**\n• Monthly (YYYYMM): Resets each calendar month\n• Seasonal (YYYYS): 3-month seasons (Winter 1-3, Spring 4-6, Summer 7-9, Fall 10-12)\n• All-Time: Cumulative career stats\n• Faction: Per-faction rankings\n• Division: Filtered by race class within season\n\n**Points by Position (base, scaled by event multiplier):**\n• 1st: 25 pts | 2nd: 18 | 3rd: 15 | 4th: 12 | 5th: 10\n• 6th: 8 | 7th-8th: 6 | 9th-10th: 4 | 11th+: 2 (participation)\n\n**Tracked Stats:**\n• Points, wins, podiums (top 3), races entered\n• Win rate, average position, total earnings\n• Current streak, best finish, trend direction (Up/Down/Stable/New)";

      let luckInfo = "**LUCK SYSTEM:**\n\n**Base Luck:**\n• Derived from token index: (tokenIndex % 100) / 2 + 10\n• Range: 10-50 base (set once at initialization)\n• Can be upgraded via luck upgrades (luckBonus added to luckBase)\n\n**Luck Procs (Positive Events):**\n• Minor: +3-5% speed boost (scales with accel), lasts 1 segment\n• Major: +6-10% speed boost, lasts 3 segments\n• Legendary: +10.5-17.5% speed boost, lasts 5 segments\n• Proc chance based on daily affinity, position, and luck stat\n• Being further behind = higher chance of Major/Legendary procs\n\n**Bad Luck Incidents:**\n• Chance formula: 6% / (1 + (luck - 10) / 30)\n• Luck 10: 6% chance | Luck 25: 4% | Luck 40: 3% | Luck 70: 2% | Luck 100: 1.5%\n• Causes time penalty (multiplier > 1.0) for several segments\n• Higher luck dramatically reduces bad luck frequency\n\n**Cosmic Alignment:**\n• Days where your bot's daily affinity exceeds 75%\n• Tracked as cosmicAlignmentDays career stat\n• Very high affinity = much higher luck proc rates that day";

      let phenomenonInfo = "**DAILY PHENOMENON (13-Day Rotating Cycle):**\n\n**Each day has a unique phenomenon affecting all races:**\n• Day 0 - Solar Flare ☀️: Power Core modulo pattern boosts affinity\n• Day 1 - Rust Storm 🌪️: Stability modulo pattern favors stable bots\n• Day 2 - Metal Resonance 🎸: Speed modulo + prime token indices boosted\n• Day 3 - Gravity Flux 🌊: Acceleration modulo pattern favors fast starters\n• Day 4 - Scrap Tornado 🌀: Wild faction bonus + token % 100 < 20 boosted\n• Day 5 - Dead Zone 💀: Dead faction + tokens containing 6/13 pattern\n• Day 6 - Golden Hour ✨: Golden faction + token % 7 == 0 boosted\n• Day 7 - Machine Ghost 👻: Ultimate/Master factions + token > 5000\n• Day 8 - Blood Moon 🔴: Murder faction + token % 9 == 0 boosted\n• Day 9 - Binary Surge 💻: Balanced stats (spread <= 10) favored\n• Day 10 - Chaos Pulse ⚡: Token % 11 == 0 + luck stat bonus\n• Day 11 - Momentum Shift 🔄: Bracket-relative underdogs (avg % 10)\n• Day 12 - Blackhole Singularity 🌌: Blackhole faction + token % 13 == 0\n\n**How Affinity Works:**\n• Each bot gets 0-100 affinity score based on the day's phenomenon\n• Higher affinity = more luck procs during races\n• Affinity depends on stats, token index, and faction matching the day's theme\n• Check affinity via garage_get_robot_details before racing!";

      let eloInfo = "**ELO RATING SYSTEM:**\n\n**Starting ELO:** 1500 for all bots\n\n**K-Factor (Volatility) by Experience:**\n• <20 races: K=10 (high volatility, ratings change fast)\n• 20-49 races: K=8 (moderate changes)\n• 50+ races: K=6 (stable, veteran ratings)\n\n**Multi-Bot Calculation:**\n• Each race does pairwise comparisons between ALL bots\n• Expected score: 1 / (1 + 10^(-diff/400)) per pair\n• ELO change = K × (actual - expected) summed across all opponents\n• Beating a higher-rated bot = bigger gain; losing to lower = bigger loss\n\n**Rating Floor:** Minimum ELO is 100 (cannot drop below)\n\n**Usage in Game:**\n• ELO is used for matchmaking WITHIN your rating-based class\n• Does NOT determine which class you can enter (that's bot Rating)\n• Helps create balanced races among bots in the same bracket";

      let eventInfo = "**EVENT SYSTEM:**\n\n**Event Types:**\n• DailySprint: Daily races at 00:00 UTC (18:00 MST)\n• FreeSprint: Free-entry races every 12h (09:00/21:00 UTC)\n• WeeklyLeague: Weekly competitive events\n• MonthlyCup: Monthly championship (guaranteed Rare+ gear drops)\n• SpecialEvent: Themed events with unique rules\n\n**Scoring Modes:**\n• Individual: Each race scored independently (default)\n• TeamAggregate: Sum points per faction (Faction Wars)\n• Cumulative: Sum points across stages per bot\n• Elimination: Bottom N eliminated each stage (future)\n\n**Entry Fee Scaling by Class:**\n• Scrap: 1.0x base fee\n• Junker: 1.5x base fee\n• Raider: 2.0x base fee\n• Elite: 2.5x base fee\n• SilentKlan: 3.0x base fee\n\n**Heat Allocation Strategies:**\n• SnakeDraft: Balanced distribution (1,4,5,8,9... | 2,3,6,7,10...)\n• SkillTiered: Group by ELO (top/mid/low heats)\n• Random: Pure random distribution\n• TopBottom: Segregate by ELO extremes\n\n**User-Created Events:**\n• Creation fee: 0.5 ICP | Min prize pool: 1.0 ICP\n• Entry fee range: 0.1-5.0 ICP | Max 3 active events per user\n• Must schedule 24h-30d in advance | Min 12h registration window";

      let cancellationInfo = "**EVENT CANCELLATION & REFUND POLICY:**\n\n**Tiered Refund Deadlines (based on time before registration closes):**\n• >48h before close: Full refund (100%)\n• 24-48h before close: Half refund (50%)\n• <24h before close: Quarter refund (25%)\n\n**Automatic Cancellation:**\n• Events cancelled if minimum entries not met\n• All bets refunded in full on cancellation\n• Entry fees refunded in full for platform-cancelled events";

      let smrInfo = "**SMR (Small Modular Reactor) SYSTEM:**\n\n**What Are SMRs?**\n• Permanent garage upgrades that increase power grid capacity\n• Power grid determines how many bots can charge simultaneously in ChargingStation\n• Base garage power: 500W | Each bot needs 100W for full-speed charging\n• More bots than capacity = slower charging for everyone (shared power)\n\n**Reactor Models:**\n• WR-250 Scrapyard Special: +250W, 5 ICP, 50 kWh lifetime (~42 charges, ~15% discount)\n• WR-500 Rust Belt Reactor: +500W, 8 ICP, 100 kWh lifetime (~83 charges, ~30% discount)\n• WR-880 Deadzone Dynamo: +880W, 12 ICP, 175 kWh lifetime (~146 charges, ~44% discount)\n• WR-1210 Flux Capacitor Elite: +1210W, 15 ICP, 275 kWh lifetime (~229 charges, ~51% discount)\n\n**Power Grid Math:**\n• Total capacity = 500W base + sum of all SMR outputs\n• Efficiency = min(1.0, totalCapacity / (botsCharging × 100))\n• When efficiency < 100%, charging speed is proportionally reduced\n• Example: 500W base, 6 bots charging = 500/600 = 83% charge speed";

      let marketplaceInfo = "**MARKETPLACE:**\n\n**Buying/Selling PokedBots NFTs:**\n• Browse and buy bots via the EXT marketplace (non-custodial)\n• NFTs are standard EXT tokens on the Internet Computer\n• After purchasing, re-initialize the bot with garage_initialize_pokedbot\n• Bots retain their stats, upgrades, and gear when transferred\n• Listed bots cannot race or scavenge until delisted\n• Check marketplace_browse_bots and marketplace_buy_bot tools";

      let content = if (section == "all") {
        coreConceptsInfo # "\n\n" # factionInfo # "\n\n" # batteryInfo # "\n\n" # resonanceInfo # "\n\n" # terrainInfo # "\n\n" # upgradeInfo # "\n\n" # scavengingInfo # "\n\n" # starterBotInfo # "\n\n" # gearInfo # "\n\n" # consumableInfo # "\n\n" # bettingInfo # "\n\n" # dedicationInfo # "\n\n" # leaderboardInfo # "\n\n" # luckInfo # "\n\n" # phenomenonInfo # "\n\n" # eloInfo # "\n\n" # eventInfo # "\n\n" # cancellationInfo # "\n\n" # smrInfo # "\n\n" # marketplaceInfo;
      } else if (section == "core") {
        coreConceptsInfo;
      } else if (section == "factions") {
        factionInfo;
      } else if (section == "battery") {
        batteryInfo;
      } else if (section == "terrain") {
        terrainInfo;
      } else if (section == "upgrades") {
        upgradeInfo;
      } else if (section == "scavenging") {
        scavengingInfo;
      } else if (section == "resonance") {
        resonanceInfo;
      } else if (section == "starter_bots") {
        starterBotInfo;
      } else if (section == "gear") {
        gearInfo;
      } else if (section == "consumables") {
        consumableInfo;
      } else if (section == "betting") {
        bettingInfo;
      } else if (section == "dedication") {
        dedicationInfo;
      } else if (section == "leaderboard") {
        leaderboardInfo;
      } else if (section == "luck") {
        luckInfo;
      } else if (section == "phenomenon") {
        phenomenonInfo;
      } else if (section == "elo") {
        eloInfo;
      } else if (section == "events") {
        eventInfo;
      } else if (section == "cancellation") {
        cancellationInfo;
      } else if (section == "smr") {
        smrInfo;
      } else if (section == "marketplace") {
        marketplaceInfo;
      } else {
        "Invalid section. Valid sections: all, core, factions, battery, terrain, upgrades, scavenging, resonance, starter_bots, gear, consumables, betting, dedication, leaderboard, luck, phenomenon, elo, events, cancellation, smr, marketplace";
      };

      let response = Json.obj([
        ("section", Json.str(section)),
        ("content", Json.str(content)),
      ]);

      ToolContext.makeSuccess(response, cb);
    };
  };
};
