         record {
           battery: float64;
           condition: float64;
           parts: float64;
         };
      }) query;
   /// Test/debug: Simulate a race with specific bots on a specific track
   /// Returns detailed results for balance testing, including race events for replay
   debug_simulate_race: (trackId: nat, tokenIndices: vec nat, seed: nat) ->
    (opt
      record {
        analysis:
         record {
           avgTime: float64;
           lastPlaceTime: float64;
           timeSpread: float64;
           winner: nat;
           winnerTime: float64;
         };
        events:
         vec
          record {
            description: text;
            eventType: text;
            segmentIndex: nat;
            timestamp: float64;
          };
        participants:
         vec
          record {
            stats:
             record {
               acceleration: nat;
               powerCore: nat;
               speed: nat;
               stability: nat;
             };
            tokenIndex: nat;
          };
        results:
         vec
          record {
            avgSegmentTime: float64;
            finalTime: float64;
            position: nat;
            tokenIndex: nat;
          };
        track:
         record {
           description: text;
           laps: nat;
           name: text;
           segmentCount: nat;
           totalDistance: nat;
           trackId: nat;
         };
      });
