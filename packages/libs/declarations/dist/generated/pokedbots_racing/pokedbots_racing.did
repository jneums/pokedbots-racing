   platformTax: nat;
   prizePool: nat;
   raceClass: RaceClass;
   raceId: nat;
   results: opt vec RaceResult;
   sponsors: vec Sponsor;
   startTime: int;
   status: RaceStatus;
   terrain: Terrain;
   trackId: nat;
   trackSeed: nat;
 };
