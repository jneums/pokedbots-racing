   LuckAmplifier: record {procChanceBonus: float64;};
   PackRunner: record {boostPercent: float64;};
   RubberBandResist: record {resistPercent: float64;};
   SlipstreamBoost: record {extraPercent: float64;};
   SteadyPace: record {varianceReduction: float64;};
   TerrainMastery: record {
                     boostPercent: float64;
                     terrain: TerrainTag;
                   };
   UphillGrinder: record {boostPercent: float64;};
 };
type NFTStats = vec nat;
type NFTMetadata = 
 vec record {
       text;
       text;
     };
type McpServer = 
 service {
   admin_add_scrap_to_rush_hour: (eventId: nat) -> (text);
   admin_adjust_leaderboard_points: (raceIds: vec nat) -> (text);
   admin_cancel_event_and_refund: (eventId: nat) -> (text);
   admin_clear_active_mission: (tokenIndex: nat) -> (text);
   admin_compensate_resimulated_winners: (raceIds: vec nat) -> (text);
   /// Admin function to manually create betting pool for an existing race
   /// Useful for testing and recovery when races are created in advance
   admin_create_betting_pool: (raceId: nat) -> (Result_2);
   admin_create_event_for_orphaned_races: (scheduledTimeNanos: int, raceIds:
    vec nat) -> (text);
   admin_get_active_mission: (tokenIndex: nat) -> (text) query;
   /// Get resonance info for a bot (admin only) - for verifying the resonance system
   admin_get_resonance: (tokenIndex: nat) -> (Result_26) query;
   /// Get detailed stat breakdown for debugging (admin only)
   admin_get_stat_breakdown: (tokenIndex: nat) -> (Result_25) query;
   admin_grant_battery: (targetPrincipal: principal, batteryType: text) ->
    (text);
   admin_migrate_gear_soulbound: () -> (Result_2);
   admin_rebuild_bot_histories: (tokenIndices: vec nat) -> (text);
   admin_remove_battery: (targetPrincipal: principal, batteryId: nat) ->
    (text);
   /// Admin method to remove a bot from a race (for fixing bugs/errors)
   admin_remove_race_entry: (raceId: nat, tokenIndex: nat) -> (Result_2);
   admin_reschedule_event: (eventId: nat, newScheduledTime: int,
    newRegistrationOpens: int, newRegistrationCloses: int) -> (text);
   admin_reset_elos: () -> (text);
   admin_resimulate_race: (raceId: nat) -> (Result_2);
   admin_resimulate_races_batch: (raceIds: vec nat) -> (text);
   admin_trigger_scheduler: () -> (text);
   admin_update_event_heat_allocation: (eventType: text, newStrategy:
    text) -> (text);
   admin_update_event_metadata: (eventId: nat, divisions: vec text,
    minEntries: nat) -> (text);
   admin_update_event_scoring_mode: (eventId: nat, scoringMode: text,
    bonusPrize: nat) -> (text);
   admin_update_event_status: (eventId: nat, status: text) -> (text);
   admin_update_prize_amounts: (raceIds: vec nat) -> (text);
   admin_update_race_min_entries: (raceId: nat, minEntries: nat) -> (text);
   cancel_actions_by_filter: (filter: ActionFilter) -> (CancellationResult);
   cancel_actions_by_ids: (ids: vec nat) -> (CancellationResult);
   cancel_races_by_ids: (raceIds: vec nat) -> (vec record {
                                                     nat;
                                                     text;
                                                   });
   /// Cancel a user-created event. Only the creator can cancel, and only before registration closes.
   /// Refunds: entry fees to all registrants + prize contribution to creator (creation fee is NOT refunded)
   cancel_user_event: (eventId: nat) -> (Result_24);
   cleanup_duplicate_race_create_timers: () -> (text);
   clear_event_races: (eventIds: vec nat) -> (text);
   /// Clear HTTP update tracking stats (owner only)
   clear_http_update_stats: () -> (Result_23);
   /// Clear method call tracking stats (owner only)
   clear_method_call_stats: () -> (Result_23);
   /// Clear race_create timer diagnostic logs (owner only)
   clear_race_create_diagnostics: () -> (Result_23);
   clear_reconstitution_traces: () -> ();
   /// * Creates a new API key. This API key is linked to the caller's principal.
   ///    * @param name A human-readable name for the key.
   ///    * @returns The raw, unhashed API key. THIS IS THE ONLY TIME IT WILL BE VISIBLE.
   create_my_api_key: (name: text, scopes: vec text) -> (text);
   /// Create a user-created event with custom config and optional bot whitelist
   /// Payment: creation fee (0.5 ICP non-refundable) + prize contribution (escrowed, refundable on cancel)
   /// Requires ICRC-2 approval for total amount (creation fee + prize contribution)
   create_user_event: (config: UserEventConfig) -> (Result_22);
   /// Test/debug: Get all available tracks
   debug_get_all_tracks: () ->
    (vec
      record {
        description: text;
        laps: nat;
        name: text;
        primaryTerrain: Terrain;
        segmentCount: nat;
        totalDistance: nat;
        trackId: nat;
      }) query;
   debug_regenerate_race_commentary: (raceId: nat) -> (Result_2);
   /// Debug: Re-simulate an existing race using its stored data
   /// This helps debug mismatches between frontend and backend simulations
   debug_resimulate_race: (raceId: nat) ->
    (opt
      record {
        originalResults:
         vec
          record {
            finalTime: float64;
            nftId: text;
            position: nat;
            stats: opt RacingStats;
          };
        raceParams:
         record {
           createdAt: int;
           distance: nat;
           participantOrder: vec text;
           terrain: Terrain;
           trackId: nat;
           trackSeed: nat;
         };
        resimulatedResults:
         vec record {
               finalTime: float64;
               nftId: text;
               position: nat;
             };
      });
   /// Debug: Get detailed scavenging calculations for a bot
   /// Shows all intermediate values for battery/condition accumulation
   debug_scavenging_calculation: (tokenIndex: nat) ->
    (opt
      record {
        baseRates:
         record {
           battery: float64;
           condition: float64;
           parts: float64;
         };
        battery: nat;
        calculatedDrain:
         record {
           batteryDrain: float64;
           conditionLoss: float64;
           partsAccumulation: float64;
         };
        chargingCurve: float64;
        condition: nat;
        currentStats:
         record {
           acceleration: nat;
           powerCore: nat;
           speed: nat;
           stability: nat;
         };
        currentTime: int;
        durationBonus: float64;
        factionBonus:
         record {
           batteryMultiplier: float64;
           conditionMultiplier: float64;
           partsMultiplier: float64;
         };
        finalRounded:
         record {
           batteryChange: int;
           conditionChange: int;
           partsGained: nat;
         };
        hasActiveMission: bool;
        hoursSinceLastAccumulation: float64;
        lastAccumulation: int;
