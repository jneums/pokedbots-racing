       module: opt GearPiece;
       thruster: opt GearPiece;
       tokenIndex: nat;
     }) query;
   /// Get faction synergy bonuses for the caller's collection
   web_get_collection_bonuses: () ->
    (record {
       costMultipliers:
        record {
          rechargeCooldown: float64;
          repair: float64;
          upgrade: float64;
        };
       drainMultipliers: record {scavenging: float64;};
       statBonuses:
        record {
          acceleration: int;
          powerCore: int;
          speed: int;
          stability: int;
        };
       yieldMultipliers: record {
                           parts: float64;
                           prizes: float64;
                         };
     }) query;
   /// Get dedication info for a specific bot
   web_get_dedication_info: (tokenIndex: nat) ->
    (record {
       activityDP: nat;
       benefits:
        record {
          accelerationBonus: nat;
          powerCoreBonus: nat;
          rechargeCooldownMult: float64;
          repairCooldownMult: float64;
          scavengingYieldMult: float64;
          speedBonus: nat;
          stabilityBonus: nat;
          terrainBonusPercent: nat;
          upgradeDiscountMult: float64;
        };
       investmentDP: nat;
       nextTierDP: opt nat;
       nextTierName: opt text;
       progressPercent: nat;
       tier: nat;
       tierName: text;
       totalDP: nat;
       totalInvestedICP: float64;
     }) query;
   /// Get garage power grid status for the caller
   /// Shows total capacity, current draw, number of bots charging, and efficiency
   web_get_garage_power_status: () ->
    (record {
       activeRepairBays: nat;
       basePowerWatts: nat;
       batteriesCharging: nat;
       batteryDrawWatts: nat;
       botsCharging: nat;
       currentDrawWatts: nat;
       effectiveBatteryDrawWatts: nat;
       efficiency: float64;
       installedSMRCount: nat;
       repairBayDrawWatts: nat;
       smrCapacityWatts: nat;
       smrLifetimePercent: float64;
       smrLifetimeTotalKwh: nat;
       smrLifetimeUsedKwh: float64;
       surplusWatts: nat;
       totalCapacityWatts: nat;
       wattsPerBot: nat;
       wattsPerBotRequired: nat;
     }) query;
   /// Get total gear stat bonuses for a bot
   web_get_gear_bonuses: (tokenIndex: nat) ->
    (record {
       acceleration: nat;
       luck: nat;
       powerCore: nat;
       speed: nat;
       stability: nat;
     }) query;
   /// Get which bot each gear piece is equipped on (gearId → tokenIndex)
   web_get_gear_equip_map: () -> (vec record {
                                        nat;
                                        nat;
                                      }) query;
   /// Get a single gear piece by ID
   web_get_gear_piece: (gearId: nat) -> (opt GearPiece) query;
   /// Get all consumables owned by a player
   web_get_player_consumables: (owner: principal) ->
    (vec ConsumableInstance) query;
   /// Get all gear owned by a player (full details)
   web_get_player_gear: (owner: principal) -> (vec GearPiece) query;
   /// Get user's bots tagged as racers
   web_get_racer_bots: () -> (vec nat) query;
   /// Get all repair bay tier configurations (for UI display)
   web_get_repair_bay_tiers: () ->
    (vec
      record {
        buildTimeSeconds: int;
        icpCostE8s: nat;
        name: text;
        partsCost: nat;
        powerDrawWatts: nat;
        repairRatePerHour: nat;
        tier: nat;
      }) query;
   /// Get upgrade costs for a specific repair bay
   web_get_repair_bay_upgrade_cost: (bayId: nat) -> (Result_12) query;
   /// Get user's bots tagged as scavengers
   web_get_scavenger_bots: () -> (vec nat) query;
   /// Get user's starred bots
   web_get_starred_bots: () -> (vec nat) query;
   /// Get total gear count (admin/stats)
   web_get_total_gear_count: () -> (nat) query;
   /// Get user's parts inventory
   web_get_user_inventory: () -> (UserInventory) query;
   /// Get user's repair bays with current status
   web_get_user_repair_bays: () ->
    (record {
       bays:
        vec
         record {
           bayId: nat;
           currentBotToken: opt nat;
           powerDrawWatts: nat;
           repairRatePerHour: nat;
           repairStartCondition: opt nat;
           repairStartTime: opt int;
           tier: nat;
           tierName: text;
           upgradeInProgress:
            opt
             record {
               completionTime: int;
               remainingSeconds: int;
               startTime: int;
               targetTier: nat;
               targetTierName: text;
             };
         };
       fallbackRepairRate: nat;
       maxBays: nat;
       nextSlotCost: opt record {
                           icpE8s: nat;
                           parts: nat;
                         };
       totalBays: nat;
       totalIcpInvested: nat;
       totalPartsInvested: nat;
     }) query;
   /// Get user's installed SMRs with individual lifetime tracking
   web_get_user_smrs: () ->
    (record {
       installedSMRs:
        vec
         record {
           installedAt: int;
           lifetimeKwh: nat;
           lifetimePercent: float64;
           model: text;
           powerOutput: nat;
           usedKwh: float64;
         };
       totalPowerOutput: nat;
     }) query;
   /// Initialize a bot for racing (web equivalent of garage_initialize_pokedbot)
   web_initialize_bot: (tokenIndex: nat, name: opt text) -> (Result_2);
   /// Jolt a bot using a battery
   web_jolt_bot: (batteryId: nat, tokenIndex: nat) -> (Result_11);
   /// List all PokedBots owned by the caller in their wallet
   web_list_my_bots: () ->
    (vec
      record {
        activeUpgrade: opt UpgradeSession;
        currentOwner: text;
        currentStats:
         opt
          record {
            acceleration: nat;
            powerCore: nat;
            speed: nat;
            stability: nat;
          };
        dedicationBonuses:
         opt
          record {
            acceleration: nat;
            powerCore: nat;
            speed: nat;
            stability: nat;
          };
        eligibleRaces:
         vec
          record {
            entryDeadline: int;
            entryFee: nat;
            name: text;
            raceId: nat;
            startTime: int;
            terrain: Terrain;
          };
        heatStatus:
         opt
          record {
            heatStacks: nat;
            isOverheated: bool;
            minutesUntilCooldown: opt nat;
          };
        isInitialized: bool;
        maxStats:
         opt
          record {
            acceleration: nat;
            powerCore: nat;
            speed: nat;
            stability: nat;
          };
        name: opt text;
        stats: opt PokedBotRacingStats;
        tokenIndex: nat;
        upcomingRaces:
         vec
          record {
            entryDeadline: int;
            entryFee: nat;
            name: text;
            raceId: nat;
            startTime: int;
            terrain: Terrain;
          };
        upgradeCostsV2:
         opt
          record {
            acceleration: record {
                            costE8s: nat;
                            successRate: float64;
                          };
            pityCounter: nat;
            powerCore: record {
                         costE8s: nat;
                         successRate: float64;
                       };
            speed: record {
                     costE8s: nat;
                     successRate: float64;
                   };
            stability: record {
                         costE8s: nat;
                         successRate: float64;
                       };
          };
      });
   /// List all PokedBots registered in the garage by the caller (QUERY - no EXT canister call)
   /// Returns only bots that have been initialized for racing
   /// Frontend should query EXT canister separately to show unregistered bots
   web_list_my_registered_bots: () ->
    (vec
      record {
        activeUpgrade: opt UpgradeSession;
        currentStats:
         record {
           acceleration: nat;
           powerCore: nat;
           speed: nat;
           stability: nat;
         };
        dedicationBonuses:
         record {
           acceleration: nat;
           powerCore: nat;
           speed: nat;
           stability: nat;
         };
        eligibleRaces:
         vec
          record {
            entryDeadline: int;
            entryFee: nat;
            name: text;
            raceId: nat;
            startTime: int;
            terrain: Terrain;
          };
        maxStats:
         record {
           acceleration: nat;
           powerCore: nat;
           speed: nat;
           stability: nat;
         };
        name: opt text;
        stats: PokedBotRacingStats;
        tokenIndex: nat;
        upcomingRaces:
         vec
          record {
            entryDeadline: int;
            entryFee: nat;
            name: text;
            raceId: nat;
            startTime: int;
            terrain: Terrain;
          };
        upgradeCostsV2:
         record {
           acceleration: record {
                           costE8s: nat;
                           successRate: float64;
                         };
           luck: record {
                   costE8s: nat;
                   successRate: float64;
                 };
           pityCounter: nat;
           powerCore: record {
                        costE8s: nat;
                        successRate: float64;
                      };
           speed: record {
                    costE8s: nat;
                    successRate: float64;
                  };
           stability: record {
                        costE8s: nat;
                        successRate: float64;
                      };
         };
      }) query;
   /// Purchase Universal Parts with ICP
   /// Cost: 1 ICP for 500 Universal Parts
   web_purchase_parts: (amount: nat) -> (Result_10);
   /// Purchase a new repair bay slot
   /// Uses ICRC-2 transfer_from to pull ICP and deducts parts from inventory
   web_purchase_repair_bay_slot: () -> (Result_9);
   /// Purchase and install an SMR (Small Modular Reactor) to increase garage power capacity
   /// Uses ICRC-2 transfer_from to pull ICP from user
   web_purchase_smr: (modelId: text) -> (Result_8);
   /// Rebuild battery core with parts or ICP
   web_rebuild_battery: (batteryId: nat, useIcp: bool) -> (Result_2);
   /// Recharge a bot's battery (0.1 ICP + fee via ICRC-2)
   web_recharge_bot: (tokenIndex: nat) -> (Result_2);
   /// Repair a battery with parts
   web_repair_battery: (batteryId: nat) -> (Result_7);
   /// Repair a bot to restore condition (0.05 ICP + fee via ICRC-2)
   web_repair_bot: (tokenIndex: nat) -> (Result_2);
   /// Respec a bot - reset selected stat upgrades and refund parts (with penalty)
   /// Cost: FREE
   /// statsToStrip: Array of stat names to reset (["speed", "powerCore", "acceleration", "stability"])
   /// Empty array strips all stats (backward compatible)
   web_respec_bot: (tokenIndex: nat, statsToStrip: vec text) -> (Result_6);
   /// Salvage a battery for parts
   web_salvage_battery: (batteryId: nat) -> (Result_5);
   /// Set user's bots tagged as racers (replaces entire list)
   web_set_racer_bots: (racerBots: vec nat) -> (Result_2);
   /// Set user's bots tagged as scavengers (replaces entire list)
   web_set_scavenger_bots: (scavengerBots: vec nat) -> (Result_2);
   /// Set user's starred bots (replaces entire list)
   web_set_starred_bots: (starredBots: vec nat) -> (Result_2);
   /// Start a scavenging mission (web method)
   web_start_scavenging: (tokenIndex: nat, zone: text, durationMinutes:
    opt nat) -> (Result_2);
   /// Toggle battery charging on/off
   web_toggle_battery: (batteryId: nat) -> (Result_4);
   /// Unequip a consumable from a bot's loadout (slot 1 or 2)
   web_unequip_consumable: (tokenIndex: nat, slot: nat) -> (Result_3);
   /// Unequip a gear slot on a bot
   web_unequip_gear: (tokenIndex: nat, slot: GearSlot) -> (Result_3);
   /// Upgrade a bot stat (via ICRC-2 payment or parts)
   web_upgrade_bot: (tokenIndex: nat, upgradeType: UpgradeType,
    paymentMethod: variant {
                     icp;
                     parts;
                   }) -> (Result_2);
   /// Start upgrading a repair bay to the next tier
   /// Uses ICRC-2 transfer_from to pull ICP and deducts parts from inventory
   web_upgrade_repair_bay: (bayId: nat) -> (Result_1);
   /// Withdraw tokens from the canister's treasury to a specified destination.
   withdraw: (ledger_id: principal, amount: nat, destination: Destination) ->
    (Result);
 };
type LeaderboardType = 
 variant {
   AllTime;
   Division: RaceClass;
   Faction: FactionType;
   Monthly: nat;
   Season: nat;
 };
type LeaderboardEntry = 
 record {
   avgPosition: float64;
   bestFinish: nat;
   currentStreak: int;
   lastRaceTime: int;
   owner: principal;
   podiums: nat;
   points: nat;
   previousRank: opt nat;
   races: nat;
   rank: nat;
   tokenIndex: nat;
   totalEarnings: nat;
   trend: TrendDirection;
   winRate: float64;
   wins: nat;
 };
type HttpResponse = 
 record {
   body: blob;
   headers: vec Header;
   status_code: nat16;
   streaming_strategy: opt StreamingStrategy;
   upgrade: opt bool;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpRequest = 
 record {
   body: blob;
   certificate_version: opt nat16;
   headers: vec Header;
   method: text;
   url: text;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type HeatAllocationStrategy = 
 variant {
   Random;
   SkillTiered;
   SnakeDraft;
   TopBottom;
 };
type Header = 
 record {
   text;
   text;
 };
type HashedApiKey = text;
type GearSlot = 
 variant {
   Chassis;
   Core;
   Gyro;
   Legs;
   Module;
   Thruster;
 };
type GearRarity = 
 variant {
   Common;
   Epic;
   Legendary;
   Rare;
   Uncommon;
 };
type GearPiece = 
 record {
   accelerationBonus: nat;
   boundToBot: nat;
   category: GearCategory;
   craftedFrom: opt vec nat;
   createdAt: int;
   description: text;
   gearId: nat;
   ilvl: nat;
   luckBonus: nat;
   name: text;
   passive: opt PassiveEffect;
   powerCoreBonus: nat;
   rarity: GearRarity;
   season: nat;
   slot: GearSlot;
   sourceEventType: opt text;
   sourceRaceId: opt nat;
   speedBonus: nat;
   stabilityBonus: nat;
   terrainTag: TerrainTag;
 };
type GearCategory = 
 variant {
   Named;
   Standard;
   Unique;
 };
type FailedPayout = 
 record {
   amount: nat;
   attempts: nat;
   betId: nat;
   error: text;
   lastAttempt: int;
   userId: principal;
 };
type FactionType = 
 variant {
   Animal;
   Bee;
   Blackhole;
   Box;
   Dead;
   Food;
   Game;
   Golden;
   Industrial;
   Master;
   Murder;
   Ultimate;
   UltimateMaster;
   Wild;
 };
type FactionStandingEntry = 
 record {
   faction: text;
   memberCount: nat;
   members: vec record {
                  owner: principal;
                  points: nat;
                  tokenIndex: nat;
                };
   position: nat;
   prizePerMember: nat;
   totalPoints: nat;
 };
type EventVisibility = 
 variant {
   Private;
   Public;
   Restricted:
    record {
      allowedBots: opt vec nat;
      allowedPlayers: opt vec principal;
      maxElo: opt nat;
      minElo: opt nat;
      requiredAchievement: opt text;
      requiredFaction: opt text;
    };
 };
type EventType = 
 variant {
   DailySprint;
   MonthlyCup;
   SpecialEvent: text;
   WeeklyLeague;
 };
type EventStatus = 
 variant {
   Announced;
   Cancelled;
   Completed;
   InProgress;
   RegistrationClosed;
   RegistrationOpen;
 };
type EventStandingEntry = 
 record {
   cumulativePoints: nat;
   owner: principal;
   position: nat;
   prizeAmount: nat;
   raceResults:
    vec record {
          points: nat;
          position: nat;
          raceId: nat;
          stageName: text;
        };
   tieGroupSize: nat;
   tied: bool;
   tokenIndex: nat;
 };
type EventRegistration = 
 record {
   entryFeePaid: nat;
   eventId: nat;
   owner: principal;
   raceClass: RaceClass;
   registeredAt: int;
   tokenIndex: nat;
 };
type EventMetadata = 
 record {
   description: text;
   divisions: vec RaceClass;
   entryFee: nat;
   eventBonusPrize: nat;
   maxEntries: nat;
   minEntries: nat;
   name: text;
   pointsMultiplier: float64;
   prizePoolBonus: nat;
   scoringMode: ScoringMode;
 };
type Distance = 
 variant {
   LongTrek;
   MediumHaul;
   ShortSprint;
 };
type Destination = 
 record {
   owner: principal;
   subaccount: opt Subaccount;
 };
type ConsumableType = 
 record {
   consumableId: text;
   description: text;
   effect: ConsumableEffect;
   ilvl: nat;
   name: text;
   rarity: GearRarity;
   trigger: ConsumableTrigger;
 };
type ConsumableTrigger = 
 variant {
   OnBadLuck;
   OnFinalLap;
   OnLastPlace;
   OnLeadChange;
   OnLuckProc;
   OnOvertaken;
   OnRaceStart;
 };
type ConsumableInstance = 
 record {
   consumableType: ConsumableType;
   createdAt: int;
   instanceId: nat;
   owner: principal;
 };
type ConsumableEffect = 
 variant {
   LuckSurge: record {guaranteedProcType: text;};
   NitroBoost: record {
                 boostPercent: float64;
                 durationSegments: nat;
               };
   OverclockPulse: record {
                     durationSegments: nat;
                     statBoost: nat;
                   };
   ShieldPlating: record {badLuckImmunitySegments: nat;};
   TerrainAdapt: record {durationSegments: nat;};
 };
type CancellationResult = 
 record {
   cancelled: vec ActionId;
   errors: vec record {
                 nat;
                 text;
               };
   notFound: vec nat;
 };
type BotSegmentTimes = 
 record {
   nftId: text;
   segmentTimes: vec float64;
 };
type BotLoadout = 
 record {
   chassis: opt nat;
   consumable1: opt nat;
   consumable2: opt nat;
   core: opt nat;
   gyro: opt nat;
   lastModified: int;
   legs: opt nat;
   module: opt nat;
   thruster: opt nat;
   tokenIndex: nat;
 };
type BettingPool = 
 record {
   betIds: vec nat;
   bettingClosesAt: int;
   bettingOpensAt: int;
   distance: nat;
   entrants: vec nat;
   failedPayouts: vec FailedPayout;
   payoutsCompleted: bool;
   placeBetsByBot: vec record {
                         nat;
                         nat;
                       };
   placePool: nat;
   raceClass: text;
   raceId: nat;
   rakeDistributed: bool;
   results: opt RaceResults;
   showBetsByBot: vec record {
                        nat;
                        nat;
                      };
   showPool: nat;
   status: PoolStatus;
   subaccount: blob;
   terrain: text;
   totalPooled: nat;
   winBetsByBot: vec record {
                       nat;
                       nat;
                     };
   winPool: nat;
 };
type BetType = 
 variant {
   Place;
   Show;
   Win;
 };
type ApiKeyMetadata = 
 record {
   hashed_key: HashedApiKey;
   info: ApiKeyInfo;
 };
type ApiKeyInfo = 
 record {
   created: Time;
   name: text;
   "principal": principal;
   scopes: vec text;
 };
type ActionId = 
 record {
   id: nat;
   time: Time__1;
 };
type ActionFilter = 
 variant {
   All;
   ByActionId: nat;
   ByRetryCount: nat;
   ByTimeRange: record {
                  Time__1;
                  Time__1;
                };
   ByType: text;
 };
type ActionDetail = 
 record {
   ActionId;
   Action;
 };
type Action = 
 record {
   aSync: opt nat;
   actionType: text;
   params: blob;
   retries: nat;
 };
service : (args: opt
                  record {
                    extCanisterId: opt principal;
                    owner: opt principal;
                  }) -> McpServer
